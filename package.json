{
  "name": "retrowright",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./core/*": "./src/core/*.ts",
    "./movie/*": "./src/movie/*.ts",
    "./patch/*": "./src/patch/*.ts",
    "./tune/*": "./src/tune/*.ts",
    "./console/*": "./src/console/*.ts",
    "./storage/*": "./src/storage/*.ts",
    "./test/*": "./src/test/*.ts",
    "./ui/testLink": "./src/ui/testLink.ts",
    "./ui/gameFiles": "./src/ui/gameFiles.ts",
    "./harness/*": "./harness/*.ts",
    "./e2e/*": "./e2e/*.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "RETROWRIGHT_BASE=/retrowright/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/firefox.mjs",
    "e2e:movie": "node e2e/movie.mjs",
    "e2e:backup": "node e2e/backup.mjs",
    "e2e:touch": "node e2e/touch.mjs",
    "e2e:display": "node e2e/display.mjs",
    "e2e:offline": "tsx e2e/offline.mjs",
    "e2e:ram-search": "node e2e/ramSearch.mjs",
    "e2e:patch": "tsx e2e/patch.mjs",
    "e2e:test-links": "tsx e2e/testLinks.mjs",
    "e2e:movie-link": "tsx e2e/movieLink.mjs",
    "e2e:mouse": "tsx e2e/mouse.mjs",
    "e2e:combos": "tsx e2e/combos.mjs",
    "e2e:opposites": "tsx e2e/opposites.mjs",
    "e2e:tune": "tsx e2e/tune.mjs",
    "e2e:replay": "tsx e2e/replay.mjs",
    "e2e:console": "tsx e2e/console.mjs",
    "e2e:pages": "tsx e2e/pages.mjs",
    "a11y": "tsx e2e/a11y.mjs",
    "e2e:all": "node e2e/all.mjs",
    "e2e:repeat": "node e2e/repeat.mjs",
    "icons": "node tools/icons.mjs",
    "licenses": "tsx harness/licensesCli.ts",
    "scan:secrets": "npm run build && secretlint --secretlintignore .secretlintignore \"**/*\" && secretlint --no-gitignore \"dist/**/*\"",
    "test:no-roms": "RETROWRIGHT_ROMS=.no-roms-here vitest run",
    "test:no-mesen": "RETROWRIGHT_MESEN=.no-mesen-here vitest run",
    "replay": "tsx harness/cli.ts",
    "hooks:cost": "tsx harness/hookCost.ts",
    "fm2": "tsx harness/fm2Cli.ts",
    "tas:trace": "tsx harness/tasTrace.ts",
    "tas:sweep": "tsx harness/tasSweep.ts",
    "diff": "tsx harness/diffCli.ts",
    "patch": "tsx harness/patchCli.ts",
    "movie:ff1": "tsx harness/makeFf1NewGame.ts"
  },
  "dependencies": {
    "jsnes": "2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.13.0",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
